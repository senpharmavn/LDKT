{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/r/:studentId", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300" }
      ]
    }
  ]
}
