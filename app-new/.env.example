# ============================================================================
# LDKT re-platform — Biến môi trường
# ----------------------------------------------------------------------------
# Copy file này thành `.env.local` (dev) và cấu hình tương ứng trên Vercel
# (Project Settings -> Environment Variables) khi deploy.
# KHÔNG commit giá trị thật vào git.
# ============================================================================

# --- Supabase (bắt buộc) ---
# Lấy tại: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# KHÓA BÍ MẬT: chỉ dùng ở server (Route Handlers). Không bao giờ để lộ ra client.
SUPABASE_SERVICE_ROLE_KEY=

# --- App URL (dùng cho link trong push notification, email mời) ---
NEXT_PUBLIC_APP_URL=https://lanhdaokhaitam.vercel.app

# --- Cron nội bộ (bảo vệ /api/push/dispatch và /api/admin/stats/rebuild) ---
# Vercel Cron tự gửi header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# --- Web Push / VAPID (giữ nguyên key cũ đang dùng, hoặc tạo mới 1 lần) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Mặc định: mailto:admin@lanhdaokhaitam.vn
VAPID_SUBJECT=

# --- Ghi chú ---
# * NEXT_PUBLIC_* được nhúng vào bundle client -> an toàn để lộ (anon key).
# * SUPABASE_SERVICE_ROLE_KEY bypass RLS -> giữ tuyệt đối bí mật.
# * Sau khi chạy migration 001 + 002 trên Supabase SQL Editor, app mới chạy được.
